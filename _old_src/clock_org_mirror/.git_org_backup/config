[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	ignorecase = true
	precomposeunicode = true
[remote "origin"]
	url = https://github.com/nukemodular/clock_plugin.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "multi"]
	remote = origin
	merge = refs/heads/multi
	vscode-merge-base = origin/multi
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
	github-pr-owner-number = "nukemodular#clock_plugin#1"
