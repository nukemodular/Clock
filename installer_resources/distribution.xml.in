<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>TOOLBOY @TB_PRODUCT_NAME@</title>
    
    <!-- Custom Sidebar Background Graphic / Logo (Bottom-Left) -->
    <background file="background.png" 
                mime-type="image/png" 
                alignment="bottomleft" 
                scaling="proportional"/>
    <background-darkAqua file="background-darkAqua.png" 
                         mime-type="image/png" 
                         alignment="bottomleft" 
                         scaling="proportional"/>

    <!-- Custom Welcome Introduction Screen -->
    <welcome file="welcome.html" mime-type="text/html"/>

    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    
    <choice id="default" title="@TB_PRODUCT_NAME@">
        <pkg-ref id="@TB_BUNDLE_ID@.pkg"/>
    </choice>
    <pkg-ref id="@TB_BUNDLE_ID@.pkg" version="@PROJECT_VERSION@" onConclusion="none">@TB_PRODUCT_NAME@_Component.pkg</pkg-ref>
</installer-gui-script>

